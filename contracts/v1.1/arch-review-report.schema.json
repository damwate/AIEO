{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieo.local/contracts/v1.1/arch-review-report.schema.json",
  "title": "AIEO architecture review report v1.1 (GPT-02 leg)",
  "description": "结构化契约 v1.1（DEC-097 #1=A：findings 由 string[] 演进为统一结构化定义，v1.0 冻结历史报告仍可读）。相对 v1.0 唯一变更=顶层 findings 改 $ref 统一定义（contracts/v1.1/_defs/findings.schema.json）；其余字段/约束/登记路线（artifacts+messages 路线 B）零改动。Ajv 使用方须先 addSchema 注册统一定义 $id。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "review_round_id",
    "reviewer_agent_id",
    "engine_agent_id",
    "input_material_commit",
    "input_material_manifest_sha256",
    "brief_sha256",
    "result",
    "summary"
  ],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "task_id": { "type": "string", "pattern": "^T-(P[0-9]+-)?[0-9]{3,}$" },
    "review_round_id": {
      "type": "string",
      "maxLength": 64,
      "description": "架构审核轮标识；幂等键=<run键>+arch-review-round-N 的结构化落位"
    },
    "reviewer_agent_id": { "type": "string", "pattern": "^GPT-02$" },
    "engine_agent_id": { "type": "string", "pattern": "^ENGINE-02$" },
    "input_material_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "审核材料版本锚定（固定 commit，禁隐式读最新 main）"
    },
    "input_material_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "brief_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result": { "enum": ["PASS", "REWORK", "BLOCKED"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "findings": {
      "$ref": "https://aieo.local/contracts/v1.1/_defs/findings.schema.json#/$defs/findings_array",
      "description": "具体发现（架构/依赖/边界/并发冲突）；PASS 时可为空数组"
    },
    "required_boundaries": {
      "type": "array",
      "items": { "type": "string" },
      "description": "审核要求维持的边界条件"
    },
    "failure_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "要求补充设计的失败路径"
    },
    "remaining_findings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "有规避但未根除的遗留发现（如实登记，不删记录）"
    },
    "unblocked": {
      "type": "boolean",
      "description": "辅助判断字段：不替代 result（Gate2-R1 §3.4 裁定）"
    }
  }
}
