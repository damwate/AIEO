{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieo.local/contracts/v1.1/engineering-audit-report.schema.json",
  "title": "AIEO engineering audit report v1.1 (GPT-05 leg)",
  "description": "结构化契约 v1.1（DEC-097 #1=A：顶层 findings 由 string[] 演进为统一结构化定义，v1.0 冻结历史报告仍可读）。相对 v1.0 唯一变更=顶层 findings 改 $ref 统一定义（contracts/v1.1/_defs/findings.schema.json）；standards_matrix[].findings 仍为单项 string（规划复审裁定保持 string，不扩大范围）；其余字段/约束/登记路线/矩阵×批次 BLOCKER 语义零改动。Ajv 使用方须先 addSchema 注册统一定义 $id。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "batch_id",
    "audit_round_id",
    "reviewer_agent_id",
    "engine_agent_id",
    "input_material_commit",
    "input_material_manifest_sha256",
    "brief_sha256",
    "standards_matrix",
    "result",
    "release_recommendation",
    "summary",
    "findings",
    "risks"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^BATCH-[0-9]{3,}$"
    },
    "audit_round_id": {
      "type": "string",
      "maxLength": 64,
      "description": "审计轮标识；幂等键=<run键>+engineering-audit-round-N 的结构化落位"
    },
    "reviewer_agent_id": {
      "type": "string",
      "pattern": "^GPT-05$"
    },
    "engine_agent_id": {
      "type": "string",
      "pattern": "^ENGINE-04$"
    },
    "input_material_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "审计材料版本锚定（完整 40 位，禁隐式读最新 main）"
    },
    "input_material_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "brief_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "standards_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "standard_id",
          "applicable",
          "requirement",
          "evidence_refs",
          "result",
          "findings",
          "residual_risks"
        ],
        "properties": {
          "standard_id": {
            "type": "string",
            "description": "规范编号（按 batches.engineering_standard_version 固定清单识别，禁临场解释）"
          },
          "applicable": {
            "type": "boolean",
            "description": "false 须 findings 说明理由；适用性不等于免检"
          },
          "requirement": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "证据指针（空须理由）"
          },
          "result": {
            "enum": [
              "PASS",
              "ISSUE",
              "BLOCKED"
            ]
          },
          "findings": {
            "type": "string",
            "description": "问题与说明（豁免理由在此）；单项说明文本，规划复审裁定保持 string"
          },
          "residual_risks": {
            "type": "string"
          }
        }
      }
    },
    "result": {
      "enum": [
        "ACCEPTED",
        "ACCEPTED_WITH_RISKS",
        "BLOCKED"
      ]
    },
    "release_recommendation": {
      "enum": [
        "SUBMIT_FOR_APPROVAL",
        "CONDITIONAL_SUBMIT_WITH_RISKS",
        "DO_NOT_SUBMIT"
      ],
      "description": "发布建议（仅建议语义，不构成发布授权；与 result 一一映射，矛盾 fail-closed）"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "findings": {
      "$ref": "https://aieo.local/contracts/v1.1/_defs/findings.schema.json#/$defs/findings_array",
      "description": "批次级结构化发现"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "批次级风险"
    }
  }
}
