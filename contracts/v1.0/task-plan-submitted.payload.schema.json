{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieo.local/contracts/v1.0/task-plan-submitted.payload.schema.json",
  "title": "AIEO TASK_PLAN_SUBMITTED Payload v1.0",
  "description": "GPT-01 提交的任务计划 payload（03-协议 §4 示例结构）：AIEO 对其做 Schema、依赖与重复 ID 校验后入库。tasks[].task_id 允许 T-<序号> 与 T-P<n>-<序号> 两种形态（T-(P\\d+-)?\\d{3,}，Phase 1 为 T-P1-<序号>）；priority 枚举与 TaskCreate 一致。",
  "type": "object",
  "additionalProperties": true,
  "required": ["result", "batch_id", "project_id", "requirement_summary", "tasks"],
  "properties": {
    "result": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "pattern": "^BATCH-\\d{3,}$" },
    "project_id": { "type": "string", "pattern": "^[A-Z0-9-]{1,32}$" },
    "requirement_summary": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["task_id", "title", "priority", "dependencies", "files_scope", "acceptance_criteria"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^T-(P\\d+-)?\\d{3,}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "description": { "type": "string" },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^T-(P\\d+-)?\\d{3,}$" }
          },
          "files_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "engineering_standard_items": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "risks": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },
  "examples": [
    {
      "result": "SUCCESS",
      "batch_id": "BATCH-001",
      "project_id": "AI-IMAGE-SERVICE",
      "requirement_summary": "增加一个生图供应商并支持故障切换",
      "tasks": [
        {
          "task_id": "T-P1-001",
          "title": "新增供应商接口适配器",
          "description": "实现统一供应商接口",
          "priority": "P1",
          "dependencies": [],
          "files_scope": ["src/providers/"],
          "acceptance_criteria": ["实现统一接口", "覆盖异常处理", "通过指定单元测试"],
          "engineering_standard_items": ["requirements", "architecture", "implementation", "code_quality", "testing", "git"],
          "risks": []
        }
      ],
      "open_questions": []
    }
  ]
}
