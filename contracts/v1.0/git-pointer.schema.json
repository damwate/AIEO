{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieo.local/contracts/v1.0/git-pointer.schema.json",
  "title": "AIEO GitPointer v1.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "transport",
    "owner",
    "repo",
    "branch",
    "commit_sha",
    "path",
    "artifact_sha256",
    "size_bytes",
    "media_type",
    "contract_version",
    "task_id",
    "execution_id"
  ],
  "properties": {
    "transport": { "const": "git_pointer" },
    "owner": { "type": "string", "minLength": 1, "maxLength": 100 },
    "repo": { "type": "string", "minLength": 1, "maxLength": 100 },
    "branch": { "type": "string", "minLength": 1, "maxLength": 200 },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!^[A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*/$).+$"
    },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "size_bytes": { "type": "integer", "minimum": 1 },
    "media_type": {
      "type": "string",
      "const": "application/vnd.aieo.git-material-manifest+json",
      "minLength": 1,
      "maxLength": 100
    },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "task_id": { "type": "string", "pattern": "^T-(P[0-9]+-)?[0-9]{3,}$" },
    "execution_id": { "type": "string", "pattern": "^EXEC-[0-9]{3,}$" }
  }
}
