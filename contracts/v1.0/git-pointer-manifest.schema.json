{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieo.local/contracts/v1.0/git-pointer-manifest.schema.json",
  "title": "AIEO GitPointer manifest v1.0",
  "$comment": "files.path 唯一性通过 Ajv ajv-keywords 的 uniqueItemProperties 关键字执行。",
  "type": "object",
  "additionalProperties": true,
  "required": ["transport", "contract_version", "task_id", "execution_id", "files"],
  "properties": {
    "transport": { "const": "git_pointer_manifest" },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "task_id": { "type": "string", "pattern": "^T-(P[0-9]+-)?[0-9]{3,}$" },
    "execution_id": { "type": "string", "pattern": "^EXEC-[0-9]{3,}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "uniqueItemProperties": ["path"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path", "artifact_sha256", "size_bytes", "media_type"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!^[A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*/$).+$"
          },
          "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "media_type": {
            "type": "string",
            "enum": ["text/plain", "text/markdown", "application/json", "application/x-ndjson"]
          }
        }
      }
    }
  }
}
