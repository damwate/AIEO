{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieo.local/contracts/v1.0/projects-create.schema.json",
  "title": "AIEO Project Create Request/Response v1.0",
  "description": "POST /api/v1/projects 请求（ProjectCreate，app/platform/schemas.py）与响应（projects 表行，registry.get_project 返回 dict(row)）。请求幂等规则：project_id 主键、name 唯一，重复→RES-0002（409）。",
  "anyOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": ["project_id", "name"],
      "properties": {
        "project_id": { "type": "string", "pattern": "^[A-Z0-9-]{1,32}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": ["string", "null"] },
        "knowledge_version": { "type": ["string", "null"] }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": true,
      "required": ["project_id", "name", "status", "created_at", "updated_at"],
      "properties": {
        "project_id": { "type": "string", "pattern": "^[A-Z0-9-]{1,32}$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "status": { "enum": ["ACTIVE", "ARCHIVED"] },
        "knowledge_version": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "examples": [
    { "project_id": "AI-IMAGE-SERVICE", "name": "AI 生图服务", "description": "示例项目", "knowledge_version": "v1" },
    {
      "project_id": "AI-IMAGE-SERVICE",
      "name": "AI 生图服务",
      "description": "示例项目",
      "status": "ACTIVE",
      "knowledge_version": "v1",
      "created_at": "2026-11-14T00:00:00.000000+00:00",
      "updated_at": "2026-11-14T00:00:00.000000+00:00"
    }
  ]
}
