{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieo.local/contracts/v1.0/tasks-detail-response.schema.json",
  "title": "AIEO Task Detail Response v1.0",
  "description": "GET /api/v1/tasks/{task_id} 响应（tasks 表行 + _task_view 派生字段，app/platform/tasks.py）。与 tasks-create.schema.json 的 response 定义同构；单列成文件供 D1′ 消费者独立校验任务详情。",
  "type": "object",
  "additionalProperties": true,
  "required": ["task_id", "batch_id", "title", "status", "priority", "weight", "files_scope", "acceptance_criteria", "engineering_standard_items", "engineering_standard_version", "knowledge_base_commit", "created_at", "updated_at", "dependencies", "latest_execution", "allowed_events"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^T-(P\\d+-)?\\d{3,}$" },
    "batch_id": { "type": "string", "pattern": "^BATCH-\\d{3,}$" },
    "parent_id": { "type": ["string", "null"], "pattern": "^T-(P\\d+-)?\\d{3,}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "status": { "enum": ["DRAFT", "PLANNING", "ARCH_REVIEW", "READY", "DISPATCHED", "IN_PROGRESS", "DEV_REPORTED", "GIT_VALIDATING", "CODE_REVIEW", "TEST_ACCEPTANCE", "REWORK", "BLOCKED", "ACCEPTED", "CANCELLED"] },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "weight": { "type": "number", "exclusiveMinimum": 0 },
    "files_scope": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "engineering_standard_items": { "type": "array", "items": { "type": "string" } },
    "task_package_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "engineering_standard_version": { "type": "string", "minLength": 1 },
    "knowledge_base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "blocked_reason": { "type": ["string", "null"] },
    "blocked_owner": { "type": ["string", "null"] },
    "unblock_condition": { "type": ["string", "null"] },
    "cancelled_by": { "type": ["string", "null"] },
    "cancelled_reason": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["depends_on_task_id", "status"],
        "properties": {
          "depends_on_task_id": { "type": "string", "pattern": "^T-(P\\d+-)?\\d{3,}$" },
          "status": { "$ref": "#/properties/status" }
        }
      }
    },
    "latest_execution": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["execution_id", "task_id", "agent_id", "attempt", "base_commit", "status", "started_at", "created_at"],
          "properties": {
            "execution_id": { "type": "string", "pattern": "^EXEC-\\d{3,}$" },
            "task_id": { "type": "string", "pattern": "^T-(P\\d+-)?\\d{3,}$" },
            "agent_id": { "type": "string", "pattern": "^[A-Z0-9-]{1,32}$" },
            "attempt": { "type": "integer", "minimum": 1 },
            "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "status": { "enum": ["RUNNING", "COMPLETED", "FAILED", "CANCELLED"] },
            "started_at": { "type": "string", "format": "date-time" },
            "ended_at": { "type": ["string", "null"], "format": "date-time" },
            "created_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "allowed_events": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "examples": [
    {
      "task_id": "T-P1-001",
      "batch_id": "BATCH-001",
      "parent_id": null,
      "title": "新增供应商接口适配器",
      "description": null,
      "status": "READY",
      "priority": "P1",
      "weight": 1.0,
      "files_scope": ["src/providers/"],
      "acceptance_criteria": ["实现统一接口"],
      "engineering_standard_items": ["implementation", "testing"],
      "task_package_hash": "1111111111111111111111111111111111111111111111111111111111111111",
      "engineering_standard_version": "v1.0.0",
      "knowledge_base_commit": "0000000000000000000000000000000000000000",
      "blocked_reason": null,
      "blocked_owner": null,
      "unblock_condition": null,
      "cancelled_by": null,
      "cancelled_reason": null,
      "created_at": "2026-11-14T00:00:00.000000+00:00",
      "updated_at": "2026-11-14T00:00:00.000000+00:00",
      "dependencies": [],
      "latest_execution": null,
      "allowed_events": ["arch_review_pass"]
    }
  ]
}
