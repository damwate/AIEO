+# ---------------- 投影：新字段进 execution_json，且经 allowlist ----------------
+def test_execution_json_projects_phase_fields():
+    class J:
+        status = 'failed'
+        error_code = 'provider_unknown_outcome'
+        route_plan_json = None
+        provider_vendor_id = None
+        provider_attempts = [{
+            'n': 1, 'stage': 'unknown_outcome', 'http_status': 200,
+            'phase_events': new_phase_events(), 'failed_phase': 'response_parse',
+            'failed_at': '2026-01-01T00:00:00+00:00', 'exception_type': 'JSONDecodeError',
+            'error_detail_safe': '供应商响应解析失败（内容不符合约定）',
+            'secret_should_not_appear': 'LEAK',
+        }]
+
+    out = execution_json(J())
+    a = out['attempts'][0]
+    assert a['failed_phase'] == 'response_parse'
+    assert a['exception_type'] == 'JSONDecodeError'
+    assert a['error_detail_safe'].startswith('供应商响应解析失败')
+    assert 'phase_events' in a
+    assert 'secret_should_not_appear' not in a
+
