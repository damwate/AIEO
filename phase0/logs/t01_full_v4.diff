+"""T01 全链路阶段事件（phase_events）回归：故障注入验证「出错可定位」。
+
+纪律：纯本地 fake，不触真实供应商；阶段事件只记状态/异常类别/白名单摘要，
+断言不泄漏原始异常消息、URL、Base64 或凭据。不改变任何失败判定语义。"""
+import json
+
+import pytest
+
+import urllib.request
+
+from app.ai.provider_outcome import (
+    PHASES, PHASE_FALLBACK, derive_phase_summary, execution_json, finish_failure,
+    new_phase_events, record_phase, reset_phase_for_rollback,
+)
+from app.ai.ai_provider_openai import OpenAICompatImageProvider, ProviderError
+from app.ai.ai_provider import GenerationRequest
+
+
+class _Provider:
+    name = 'openai_compat'
+    billable = True
+
+
+# ---------------- 阶段记录基础语义 ----------------
+def test_phase_events_init_all_not_reached():
+    ev = new_phase_events()
+    assert [e['name'] for e in ev] == list(PHASES)
+    assert all(e['status'] == 'not_reached' and e['at'] is None for e in ev)
+
+
+def test_phase_terminal_state_is_immutable_in_both_directions():
+    attempt = {'phase_events': new_phase_events()}
+    record_phase(attempt, 'response_parse', 'running')
+    record_phase(attempt, 'response_parse', 'succeeded')
+    for bad in ('running', 'failed', 'not_applicable', 'not_reached'):
+        record_phase(attempt, 'response_parse', bad, exc=ValueError('x'))
+    ev = [e for e in attempt['phase_events'] if e['name'] == 'response_parse']
+    assert len(ev) == 1 and ev[0]['status'] == 'succeeded'
+
+    attempt2 = {'phase_events': new_phase_events()}
+    record_phase(attempt2, 'image_decode', 'failed', exc=ValueError('x'))
+    for bad in ('running', 'succeeded', 'not_applicable', 'not_reached'):
+        record_phase(attempt2, 'image_decode', bad)
+    ev2 = [e for e in attempt2['phase_events'] if e['name'] == 'image_decode']
+    assert len(ev2) == 1 and ev2[0]['status'] == 'failed'
+    assert 'error_detail_safe' in ev2[0]  # 终态摘要未被后续覆盖清空
+
+
+def test_phase_terminal_has_start_and_end_time():
+    attempt = {'phase_events': new_phase_events()}
+    record_phase(attempt, 'download', 'running', at='2026-01-01T00:00:00+00:00')
+    record_phase(attempt, 'download', 'succeeded')
+    ev = next(e for e in attempt['phase_events'] if e['name'] == 'download')
+    assert ev['at'] == '2026-01-01T00:00:00+00:00'  # 开始时间保留
+    assert ev['completed_at']  # 结束时间存在，可据两者算耗时
+
+
+def test_record_phase_unknown_name_is_noop():
+    attempt = {'phase_events': new_phase_events()}
+    record_phase(attempt, 'not_a_phase', 'failed')
+    assert all(e['name'] in PHASES for e in attempt['phase_events'])
+
+
+# ---------------- HTTP 200 后解析失败可定位（Yuanqiao 事故同型）----------------
+def test_http200_invalid_json_locates_response_parse():
+    att = {'phase_events': new_phase_events(), 'stage': 'in_flight'}
+    payload = b'{not json'
+    with pytest.raises(ProviderError):
+        OpenAICompatImageProvider._decode_json(payload, att)
+    finish_failure(att, ProviderError('provider_error', 'x'), _Provider())
+    fail = [e for e in att['phase_events'] if e['status'] == 'failed']
+    assert fail and fail[-1]['name'] == 'response_parse'
+    assert att['failed_phase'] == 'response_parse'
+    assert att['exception_type'] == 'JSONDecodeError'
+
+
+def test_http200_missing_data0_locates_result_extract():
+    att = {'phase_events': new_phase_events()}
+    prov = OpenAICompatImageProvider()
+    with pytest.raises(ProviderError):
+        prov._edits_image_from_json({'created': 1}, 30, None, att)
+    derive_phase_summary(att, ProviderError('provider_error', 'x'))
+    fail = [e for e in att['phase_events'] if e['status'] == 'failed']
+    assert fail and fail[-1]['name'] == 'result_extract'
+    assert att['failed_phase'] == 'result_extract'
+
+
+def test_http200_invalid_b64_locates_image_decode():
+    att = {'phase_events': new_phase_events()}
+    prov = OpenAICompatImageProvider()
+    with pytest.raises(ProviderError):
+        prov._edits_image_from_json({'data': [{'b64_json': '!!!not-base64!!!'}]}, 30, None, att)
+    derive_phase_summary(att, ProviderError('provider_error', 'x'))
+    assert att['failed_phase'] == 'image_decode'
+
+
+# ---------------- 脱敏：原始异常消息绝不进入安全摘要 ----------------
+def test_error_detail_safe_never_leaks_raw_message():
+    att = {'phase_events': new_phase_events()}
+    secret = 'sk-SECRET-API-KEY-https://cdn.example/signed?token=LEAKME'
+    err = ValueError(secret)
+    record_phase(att, 'response_parse', 'failed', exc=err)
+    derive_phase_summary(att, err)
+    assert secret not in json.dumps(att, ensure_ascii=False)
+    assert att['error_detail_safe'].startswith('供应商响应解析失败')
+    assert att['exception_type'] == 'ValueError'
+
+
+# ---------------- worker 兜底：适配器未记失败节点 → worker_unclassified ----------------
+def test_worker_fallback_when_adapter_did_not_record_failed_phase():
+    att = {'phase_events': new_phase_events(), 'stage': 'in_flight'}
+    err = RuntimeError('unexpected adapter crash')
+    finish_failure(att, err, _Provider())
+    assert att['failed_phase'] == PHASE_FALLBACK
+    fb = next(e for e in att['phase_events'] if e['name'] == PHASE_FALLBACK)
+    assert fb['status'] == 'failed' and fb['exception_type'] == 'RuntimeError'
+    assert 'unexpected adapter crash' not in json.dumps(att, ensure_ascii=False)
+
