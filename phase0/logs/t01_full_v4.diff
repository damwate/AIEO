+def test_http_error_receive_phase_succeeded_not_failed(monkeypatch):
+    """HTTPError：已收到响应 → response_received=succeeded，非 2xx 由 http_status 表达。"""
+    import io
+    import urllib.error
+
+    def raise_404(req, *a, **k):
+        raise urllib.error.HTTPError(req.full_url, 400, 'Bad Request', {}, io.BytesIO(b'{}'))
+
+    monkeypatch.setattr(urllib.request, 'urlopen', raise_404)
+    attempt = {'n': 1, 'stage': 'in_flight', 'phase_events': new_phase_events()}
+    prov = OpenAICompatImageProvider()
+    with pytest.raises(ProviderError):
+        prov._post_raw('https://provider.example/v1/responses', b'{}',
+                       'application/json', 30, 'test', attempt)
+    rx = next(e for e in attempt['phase_events'] if e['name'] == 'response_received')
+    assert rx['status'] == 'succeeded'
+    assert attempt.get('http_status') == 400
+
