+def test_e2e_http200_parse_failure_located_through_full_chain(monkeypatch):
+    """完整链路：generate_image 收到非法 JSON 的 HTTP200 → 阶段定位 response_parse →
+    worker finish_failure 收口 → execution_json 投影。不触真实供应商。"""
+    monkeypatch.setattr(urllib.request, 'urlopen', _fake_urlopen(b'{not json'))
+    attempt = {'n': 1, 'stage': 'in_flight', 'phase_events': new_phase_events(),
+               'http_status': 200}
+    req = GenerationRequest(job_id='e2e', preset_key='noon', prompt='x',
+                            references=[], camera_snapshot={},
+                            input_image=None, input_mime=None, attempt=attempt,
+                            provider_config={'base_url': 'https://provider.example',
+                                             'api_key': 'test', 'channel': 'responses'})
+    prov = OpenAICompatImageProvider()
+    err = None
+    try:
+        prov.generate_image(req)
+    except ProviderError as e:
+        err = e
+    assert err is not None
+    finish_failure(attempt, err, _Provider())
+
+    # 响应接收成功、解析失败：事实分层正确
+    rx = next(e for e in attempt['phase_events'] if e['name'] == 'response_received')
+    parse = next(e for e in attempt['phase_events'] if e['name'] == 'response_parse')
+    assert rx['status'] == 'succeeded'
+    assert parse['status'] == 'failed'
+    assert attempt['failed_phase'] == 'response_parse'
+    assert attempt['http_status'] == 200  # HTTP 状态仍由既有字段表达
+
+    class J:
+        status = 'failed'
+        error_code = 'provider_unknown_outcome'
+        route_plan_json = None
+        provider_vendor_id = None
+        provider_attempts = [attempt]
+    out = execution_json(J())
+    assert out['attempts'][0]['failed_phase'] == 'response_parse'
+
