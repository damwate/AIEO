+def test_output_commit_optimistic_terminal_rollback_is_consistent():
+    """提交失败注入：乐观 succeeded 经事务撤销后落 failed，扁平摘要与投影一致，
+    不会留下「DB running / 内存 immutable succeeded」的不可恢复态（评审 P1-01）。"""
+    attempt = {'n': 1, 'stage': 'in_flight', 'phase_events': new_phase_events(),
+               'http_status': 200}
+    # 模拟 write_success：乐观写 succeeded 进快照
+    record_phase(attempt, 'output_commit', 'running')
+    record_phase(attempt, 'output_commit', 'succeeded')
+    snapshot_committed = [dict(a) for a in [attempt]]  # 假如本次 commit 成功将落库的快照
+
+    # 注入：commit 失败 → 回滚 + 撤销乐观终态 + 改记 failed
+    commit_error = RuntimeError('db commit failed')
+    reset_phase_for_rollback(attempt, 'output_commit')
+    record_phase(attempt, 'output_commit', 'failed', exc=commit_error)
+    final_snapshot = [dict(a) for a in [attempt]]
+
+    oc = next(e for e in final_snapshot[0]['phase_events'] if e['name'] == 'output_commit')
+    assert oc['status'] == 'failed'  # 不再是不可回退的 succeeded
+    assert snapshot_committed[0]['phase_events'][-1]['name'] == 'output_commit'  # 快照结构正常
+    derive_phase_summary(attempt, commit_error)
+    assert attempt['failed_phase'] == 'output_commit'
+
+    class J:
+        status = 'failed'
+        error_code = 'output_storage_failed'
+        route_plan_json = None
+        provider_vendor_id = None
+        provider_attempts = final_snapshot
+    out = execution_json(J())
+    proj = next(e for e in out['attempts'][0]['phase_events'] if e['name'] == 'output_commit')
+    assert proj['status'] == 'failed'  # 投影与内存/摘要三方一致
+
