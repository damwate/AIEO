+# ---------------- 端到端：HTTP 200 → 响应接收 → 解析失败 → worker 收口 → 投影 ----------------
+def _fake_urlopen(payload: bytes):
+    class _R:
+        status = 200
+        headers = {'Content-Type': 'application/json'}
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *a):
+            return False
+
+        def read(self):
+            return payload
+    return lambda req, *a, **k: _R()
+
