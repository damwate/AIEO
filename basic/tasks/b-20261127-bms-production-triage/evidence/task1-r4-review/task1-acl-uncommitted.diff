+
+    /**
+     * 统一token有效期判断；NULL、恰到期和已过期均无效。
+     * Date按绝对时间比较，调用方传入当前时间，便于固定时间做边界测试。
+     */
+    public boolean isValid(Date now) {
+        return expireTime != null && now != null && expireTime.after(now);
+    }
 }
