+            } finally {
+                fileLock = null;
+            }
+        }
+        closeChannelQuietly();
+    }
+
+    private static void closeChannelQuietly() {
+        if (lockChannel != null) {
+            try {
+                lockChannel.close();
+            } catch (Throwable t) {
+                failureEvidence.add("文件锁通道关闭异常：" + t);
