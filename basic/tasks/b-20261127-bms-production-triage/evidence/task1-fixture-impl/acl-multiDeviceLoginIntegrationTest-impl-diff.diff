+    // ==================== 双锁获取与释放（§2顺序，fail-closed） ====================
+
+    private static void acquireProcessFileLock() throws Exception {
+        // R6 P1-1冻结：user.home锚定固定机器级路径；目录创建/路径解析/文件打开/锁获取任一步失败均fail-closed。
+        // 边界（如实声明）：跨OS用户/跨主机/不同文件系统命名空间不覆盖；runner禁止-Duser.home覆盖。
+        Path lockPath = Paths.get(System.getProperty("user.home"), ".acl-it", "acl-it-fixture-mutex.lock");
+        Files.createDirectories(lockPath.getParent());
+        lockChannel = FileChannel.open(lockPath, StandardOpenOption.CREATE, StandardOpenOption.WRITE);
+        try {
+            fileLock = lockChannel.tryLock();
+        } catch (OverlappingFileLockException e) {
+            closeChannelQuietly();
+            throw new IllegalStateException("同JVM重复获取文件锁（OverlappingFileLockException），fail-closed", e);
+        }
+        if (fileLock == null) {
+            closeChannelQuietly();
+            throw new IllegalStateException("文件锁tryLock未获得（他进程持锁），fail-closed");
+        }
+        recordLifecycle("进程级文件锁已获取：" + lockPath);
+    }
+
+    private void openLockConnection() throws SQLException {
+        lockConnection = dataSource.getConnection();
+        lockConnection.setAutoCommit(true);
+        recordLifecycle("锁连接L已建立（autocommit=true）");
+    }
+
+    private static void acquireMysqlNamedLock() throws SQLException {
+        try (PreparedStatement ps = lockConnection.prepareStatement(
+                "SELECT GET_LOCK('" + MYSQL_LOCK_NAME + "', 0)");
+             ResultSet rs = ps.executeQuery()) {
+            rs.next();
+            int result = rs.getInt(1);
+            if (rs.wasNull()) {
+                throw new IllegalStateException("GET_LOCK返回NULL，fail-closed");
+            }
+            if (result != 1) {
+                throw new IllegalStateException("GET_LOCK返回" + result + "（他会话持锁），fail-closed");
+            }
+        }
+        recordLifecycle("MySQL命名锁已获取：" + MYSQL_LOCK_NAME + "（由连接L持有至清理验证完成）");
+    }
+
+    private static void releaseMysqlNamedLock() throws SQLException {
+        try (Statement st = lockConnection.createStatement();
+             ResultSet rs = st.executeQuery("SELECT RELEASE_LOCK('" + MYSQL_LOCK_NAME + "')")) {
+            rs.next();
+            int result = rs.getInt(1);
+            if (rs.wasNull() || result != 1) {
+                throw new IllegalStateException("RELEASE_LOCK返回"
+                        + (rs.wasNull() ? "NULL" : String.valueOf(result)) + "（预期1），fail-closed");
+            }
+        }
+        lockHeld = false;
+        recordLifecycle("MySQL命名锁已释放（RELEASE_LOCK=1核验通过）");
+    }
+
+    private static void closeLockConnectionQuietly() {
+        if (lockConnection == null) {
+            return;
+        }
+        try {
+            lockConnection.close();
+            recordLifecycle("锁连接L已关闭");
+        } catch (Throwable t) {
+            recordLifecycle("锁连接L关闭异常（按已关闭处理）：" + t);
+        } finally {
+            lockConnection = null;
+        }
+    }
+
+    private static void releaseFileLockQuietly() {
+        if (fileLock != null) {
+            try {
+                fileLock.release();
+                recordLifecycle("进程级文件锁已释放");
+            } catch (Throwable t) {
