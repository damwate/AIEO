@@ -802,71 +802,73 @@ public class QuoteServiceImpl extends ServiceImpl<QuoteOrderDao, QuoteOrder> imp
         BigDecimal amount = BigDecimal.ZERO;
         for (SchemeItem item : items) {
             List<QuoteDetail> skuDetails = details.stream()
                     .filter(d -> d.getSchemeItemId().equals(item.getId()))
                     .collect(Collectors.toList());
 
             boolean quoted = true;
             BigDecimal total = BigDecimal.ZERO;
             for (QuoteDetail skuDetail : skuDetails) {
                 if (skuDetail.getSkuQty() == null) {
                     quoted = false;
                     continue;
                 }
                 total = total.add(skuDetail.getSkuUnitPrice().multiply(BigDecimal.valueOf(skuDetail.getSkuQty())));
             }
 
             item.setPrice(total);
             item.setQuoted(quoted);
             if (!item.updateById()) {
                 throw new RuntimeException();
             }
             amount = amount.add(total);
         }
 
         order.setSkuPrice(amount);
         order.setTotalPrice(calcTotalPrice(order));
         if (!order.updateById()) {
             throw new RuntimeException("报价单保存失败");
         }
         return true;
     }
 
