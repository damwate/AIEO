@@ -91,3 +91,33 @@ def test_config_pruning_keeps_queued_generic_provider_snapshot(env):
         db.commit()
         _prune_generations(doc, db)
         assert '1' not in doc['generations']
+
+
+def test_final_outbound_size_tracks_job_params_not_vendor_default(monkeypatch):
+    """L1/L2 零费用覆盖链：供应商配置 size 会被任务 params 覆盖；未传时明确回落 auto。
+    在 provider 最终 _post_raw 边界截获，防止中间层构造正确、出站前又被改写。"""
+    import base64
+    import json
+    from types import SimpleNamespace
+    from app.ai.job_spec import GENERIC_SPEC
+    from app.ai.ai_provider_openai import OpenAICompatImageProvider
+
+    for params, expected in [({'size': '2048x2048'}, '2048x2048'), ({}, 'auto')]:
+        cfg = dict(provider='openai_compat', base_url='https://example.test', api_key='test',
+                   model='gpt-image-2.6-sunburst', channel='generations',
+                   size='1024x1024', quality='low', output_format='png')
+        job = SimpleNamespace(job_id='size-override', prompt='size contract', params_json=params)
+        request = GENERIC_SPEC.build_request(job, cfg, input_images=[],
+                                            input_image=None, input_mime=None, ref_images=[])
+        calls = []
+
+        def post_raw(url, body, content_type, timeout, bearer, attempt=None, **_kwargs):
+            calls.append(json.loads(body))
+            payload = {'data': [{'b64_json': base64.b64encode(png_bytes(2, 2)).decode()}]}
+            return 'application/json', json.dumps(payload).encode()
+
+        provider = OpenAICompatImageProvider()
+        monkeypatch.setattr(provider, '_post_raw', post_raw)
+        assert provider.generate_image(request).image_bytes
+        assert len(calls) == 1
+        assert calls[0]['size'] == expected
