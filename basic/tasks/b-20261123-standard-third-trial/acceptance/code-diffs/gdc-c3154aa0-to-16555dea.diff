+++ b/src/backend/app/ai/product_constraints.py
@@ -0,0 +1,76 @@
+"""R1 产品占比清单（issue #126）：从冻结 reference_selection_json 派生可审计的产品约束。
+单一事实源=Job.reference_selection_json；本模块只读派生，绝不重新选品/算分/算占比。
+双写：prompt 文本区块（模型可读）+ params.product_constraints（可校验审计），同源派生。
+MF-01：缺失 variant → params color_variant=null，prompt 省略颜色规格段。
+MF-02：内部 0..1，params 保留原始 float；prompt=(x*100) 一位小数百分数（Decimal ROUND_HALF_UP）。
+fail-closed：NaN/Infinity/越界/name 缺失 → ValueError（调用层转 422），不静默降级。
+"""
+from decimal import Decimal, ROUND_HALF_UP
+
+HEADER = ('【产品选择与画面占比约束】以下产品均为本次设计必须参考的产品，'
+          '请使用对应产品原图作为外观、颜色和材质依据。')
+FOOTER = '请保持产品外观与参考原图一致，并尽可能遵循上述画面占比。'
+
+
+def validate_coverage(x):
+    """finite 且 0..1，否则 ValueError。bool 拒绝（Python bool 是 int 子类，必须显式挡）。"""
+    if isinstance(x, bool) or not isinstance(x, (int, float)):
+        raise ValueError(f'screen_coverage 必须为数值，实得 {type(x).__name__}')
+    if x != x or x in (float('inf'), float('-inf')):  # NaN / Infinity
+        raise ValueError('screen_coverage 必须为有限数值')
+    if not (0 <= x <= 1):
+        raise ValueError(f'screen_coverage 越界：{x}（须在 [0,1]）')
+    return float(x)
+
+
+def _coverage_pct(x):
+    """0..1 → 一位小数百分数字符串（Decimal ROUND_HALF_UP，禁止 Python round ties-to-even）。"""
+    pct = (Decimal(str(x)) * 100).quantize(Decimal('0.1'), rounding=ROUND_HALF_UP)
+    return f'{pct}%'
+
+
+def build_product_constraints(selection, assets):
+    """selection=冻结 reference_selection_json（含 selected[]）；assets=catalog.json（load_assets_cached()）。
+    返回 [{'name','color_variant','score','screen_coverage'}]，顺序=selected 原序。
+    placement 域 name 取 catalog.products[subject_id].name（fail-closed，不回退 subject_id）；
+    其他域 name=subject_id（必须非空）。color_variant=subject.variant，空/None→None。"""
+    if not selection:
+        return []
+    products = (assets or {}).get('products') or {}
+    items = []
+    for entry in selection.get('selected') or []:
+        subject = entry.get('subject') or {}
+        domain = subject.get('domain')
+        subject_id = subject.get('subject_id')
+        if domain == 'placement':
+            product = products.get(subject_id) or {}
+            name = product.get('name')
+            if not name or not str(name).strip():
+                raise ValueError(f'placement 域产品 {subject_id!r} 在 catalog 中缺失 name')
+            name = str(name).strip()
+        else:
+            if not subject_id or not str(subject_id).strip():
+                raise ValueError(f'{domain} 域 subject_id 缺失')
+            name = str(subject_id).strip()
+        variant = subject.get('variant')
+        variant = variant if (variant and str(variant).strip()) else None
+        coverage = validate_coverage(entry.get('screen_coverage'))
+        score = entry.get('score')
+        items.append({'name': name, 'color_variant': variant,
+                      'score': score, 'screen_coverage': coverage})
+    return items
+
+
+def format_constraint_block(items):
+    """items=build_product_constraints 输出 → golden 文本区块。空列表返回空串。"""
+    if not items:
+        return ''
+    lines = [HEADER]
+    for i, it in enumerate(items, 1):
+        seg = f'{i}. 产品：{it["name"]}'
+        if it.get('color_variant'):
+            seg += f' 颜色规格：{it["color_variant"]}'
+        seg += f' 画面占比：{_coverage_pct(it["screen_coverage"])}'
+        lines.append(seg)
+    lines.append(f'…共计{len(items)}项。{FOOTER}')
+    return '\n'.join(lines)
