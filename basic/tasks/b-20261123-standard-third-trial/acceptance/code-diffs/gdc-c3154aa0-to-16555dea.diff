+++ b/src/backend/tests/test_product_constraints.py
@@ -0,0 +1,114 @@
+"""R1 产品占比清单单元测试：MF-01 缺失 variant 序列化、MF-02 数值舍入、fail-closed、旧任务兼容。
+被测：app.ai.product_constraints（validate_coverage/build_product_constraints/format_constraint_block）。
+"""
+import pytest
+from app.ai.product_constraints import (
+    build_product_constraints, format_constraint_block, validate_coverage,
+)
+
+ASSETS = {'products': {
+    'p-1': {'name': '景观灯'}, 'p-2': {'name': '户外花盆'},
+    'p-3': {'name': '木平台'}, 'p-4': {'name': '防腐木围栏'},
+    'p-5': {'name': '户外长椅'}, 'p-6': {'name': '遮阳伞'},
+}}
+
+
+def _sel(subject_id='p-1', domain='placement', variant='暖白', coverage=0.182, score=0.9):
+    return {'selected': [{'rank': 1,
+                          'subject': {'domain': domain, 'subject_id': subject_id, 'variant': variant},
+                          'score': score, 'screen_coverage': coverage}]}
+
+
+def test_normal_mapping_and_golden_block():
+    items = build_product_constraints(_sel(), ASSETS)
+    assert items == [{'name': '景观灯', 'color_variant': '暖白', 'score': 0.9, 'screen_coverage': 0.182}]
+    block = format_constraint_block(items)
+    assert '产品：景观灯' in block
+    assert '颜色规格：暖白' in block
+    assert '画面占比：18.2%' in block  # 0.182*100=18.2 一位小数无空格
+    assert block.startswith('【产品选择与画面占比约束】')
+    assert '…共计1项。' in block
+
+
+def test_missing_variant_omits_color_segment_mf01():
+    for variant in (None, '', '   '):
+        items = build_product_constraints(_sel(variant=variant), ASSETS)
+        assert items[0]['color_variant'] is None
+        block = format_constraint_block(items)
+        assert '颜色规格' not in block  # 省略，禁止字面量 None/null/占位符
+        assert 'None' not in block and 'null' not in block
+
+
+def test_order_matches_selected():
+    sel = {'selected': [
+        {'rank': 1, 'subject': {'domain': 'placement', 'subject_id': 'p-1', 'variant': '暖白'},
+         'score': 0.9, 'screen_coverage': 0.182},
+        {'rank': 2, 'subject': {'domain': 'placement', 'subject_id': 'p-2', 'variant': None},
+         'score': 0.7, 'screen_coverage': 0.125},
+    ]}
+    items = build_product_constraints(sel, ASSETS)
+    assert [it['name'] for it in items] == ['景观灯', '户外花盆']
+    block = format_constraint_block(items)
+    assert block.index('景观灯') < block.index('户外花盆')
+    assert '…共计2项。' in block
+    # 第一项有颜色段、第二项省略
+    assert block.count('颜色规格') == 1
+
+
+def test_coverage_half_up_rounding_mf02():
+    # 0.1505*100=15.05 → HALF_UP=15.1（Python round 会 ties-to-even 到 15.0，禁止）
+    items = build_product_constraints(_sel(coverage=0.1505), ASSETS)
+    assert '画面占比：15.1%' in format_constraint_block(items)
+    # 0.1504*100=15.04 → 15.0
+    items = build_product_constraints(_sel(coverage=0.1504), ASSETS)
+    assert '画面占比：15.0%' in format_constraint_block(items)
+    # 边界 0 与 1
+    assert '画面占比：0.0%' in format_constraint_block(build_product_constraints(_sel(coverage=0), ASSETS))
+    assert '画面占比：100.0%' in format_constraint_block(build_product_constraints(_sel(coverage=1), ASSETS))
+
+
+@pytest.mark.parametrize('bad', [float('nan'), float('inf'), float('-inf'), -0.01, 1.01, '0.5', True, None])
+def test_validate_coverage_fail_closed(bad):
+    with pytest.raises(ValueError):
+        validate_coverage(bad)
+
+
+@pytest.mark.parametrize('bad', [float('nan'), float('inf'), -0.1, 1.5])
+def test_build_fail_closed_on_bad_coverage(bad):
+    with pytest.raises(ValueError):
+        build_product_constraints(_sel(coverage=bad), ASSETS)
+
+
+def test_missing_placement_name_fail_closed():
+    # id 不在 catalog → 不回退 subject_id，直接 ValueError
+    with pytest.raises(ValueError):
+        build_product_constraints(_sel(subject_id='p-not-exist'), ASSETS)
+    # name 为空 → ValueError
+    with pytest.raises(ValueError):
+        build_product_constraints(_sel(subject_id='p-empty'), {'products': {'p-empty': {'name': '  '}}})
+
+
+def test_non_placement_domain_uses_subject_id():
+    items = build_product_constraints(_sel(domain='surface', subject_id='deck-1', variant=None), ASSETS)
+    assert items[0]['name'] == 'deck-1'
+    with pytest.raises(ValueError):
+        build_product_constraints(_sel(domain='surface', subject_id='  '), ASSETS)
+
+
+def test_empty_selection_returns_empty_and_no_block():
+    assert build_product_constraints(None, ASSETS) == []
+    assert build_product_constraints({'selected': []}, ASSETS) == []
+    assert format_constraint_block([]) == ''
+
+
+def test_retry_stability_same_job():
+    sel = _sel()
+    a = build_product_constraints(sel, ASSETS)
+    b = build_product_constraints(sel, ASSETS)
+    assert a == b
+    assert format_constraint_block(a) == format_constraint_block(b)
+
+
+def test_params_preserve_raw_float_not_percent():
+    items = build_product_constraints(_sel(coverage=0.182), ASSETS)
+    assert items[0]['screen_coverage'] == 0.182  # params 保留原始值，不是 18.2
