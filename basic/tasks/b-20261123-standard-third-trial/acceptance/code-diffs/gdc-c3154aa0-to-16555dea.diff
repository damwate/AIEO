+// ---------------- R3 任务详情纯函数（gdc-aigen-admin-20261123，issue #126）----------------
+/** sha256 短码（清单展示用；缺省 —）。 */
+export function shaShort(sha:string|null|undefined):string{
+  return sha?sha.slice(0,8):'—';
+}
+/** 输入截图清单行：`#槽位 storage_key · sha短码`。 */
+export function inputImageLine(img:AiJobInputImage):string{
+  return `#${img.slot} ${img.storage_key} · ${shaShort(img.sha256)}`;
+}
+/** 产品参考清单行（issue #126 样式）：`#1 柔纹白 · 评分 0.32 · 画面占比 14.3%`
+ *  （占比=screen_coverage×100 一位小数；排序依据=score 降序即 rank，由后端 rank 给出）。 */
+export function referenceLineText(e:AiJobReferenceEntry):string{
+  const name=e.display_name||e.subject?.subject_id||'?';
+  const variant=e.subject?.variant;
+  const bits=[`#${e.rank??'?'} ${name}${variant?' '+variant:''}`];
+  if(typeof e.score==='number')bits.push(`评分 ${e.score.toFixed(2)}`);
+  if(typeof e.screen_coverage==='number')bits.push(`画面占比 ${(e.screen_coverage*100).toFixed(1)}%`);
+  return bits.join(' · ');
+}
+/** 未入选参考摘要：`名称 · 原因 xxx · 画面占比 y%`。 */
+export function rejectedLineText(e:AiJobReferenceEntry):string{
+  const name=e.display_name||e.subject?.subject_id||'?';
+  const bits=[name];
+  if(e.reason)bits.push(`原因 ${e.reason}`);
+  if(typeof e.screen_coverage==='number')bits.push(`画面占比 ${(e.screen_coverage*100).toFixed(1)}%`);
+  return bits.join(' · ');
+}
