            raise TemplateValidationError("DIAGNOSTIC_LEGAL_POOL_MISMATCH")
        if any(not item.validator.get("valid") or
               "bom" not in item.quote or "total" not in item.quote
               for item in result.candidates):
            raise TemplateValidationError("DIAGNOSTIC_UNVERIFIED_CANDIDATE")
    
        library = template_inventory(context)
        reasons: Counter[str] = Counter()
        phases: Counter[str] = Counter()
        for row in result.filters:
            code = _safe_reason(row.reason_code)
            reasons[code] += 1
            phases[_failure_phase(code)] += 1
        for row in records:
            if row.outcome == "legal":
                continue
            code = _safe_reason(row.reason_code)
            reasons[code] += 1
            phases[_failure_phase(code)] += 1
    
