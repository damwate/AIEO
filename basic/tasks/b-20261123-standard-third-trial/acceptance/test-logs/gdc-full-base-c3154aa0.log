    def test_variant_metadata_matches_real_scene(pool):
        for s in pool:
            pc = s.candidate_metadata.get('premium_constructive', {})
            kind = pc.get('variant_kind')
            if not kind:
                continue
            real_furniture = sorted(p.product_id for p in s.placements
                                    if 'furniture' in p.product_id)
            assert len(real_furniture) == len(pc['furniture']), kind
            if '_furn_min' in kind:
                # table plus at least one usable seat, never marked as full combo;
                # must hold for BOTH no_focal_furn_min and
                # no_focal_furn_min_deck_reduced
                assert 'furniture_table_double' in real_furniture, kind
                assert any('chair' in pid or 'bench_long' in pid
                           for pid in real_furniture), kind
                assert len(real_furniture) == 2, (kind, real_furniture)
            if kind.endswith('deck_reduced'):
                # metadata must record the REAL reduced expansion, never the full
                # one: added area can never exceed the scene's actual deck total,
                # and a reduced variant stays under the full-composition deck.
                assert 0 < pc['deck_added_m2'] <= deck_m2(s) + 1e-6, \
                    (kind, pc['deck_added_m2'], deck_m2(s))
                assert deck_m2(s) < 20.0, (kind, deck_m2(s))
            # no focal products survive a no_focal variant
            assert not any('tree_table' in p.product_id or 'water_feature' in p.product_id
                           for p in s.placements), kind
        # both furniture-subset variants must actually be exercised
        kinds_seen = {s.candidate_metadata['premium_constructive'].get('variant_kind')
                      for s in pool if s.candidate_metadata.get('premium_constructive', {}).get('variant_kind')}
