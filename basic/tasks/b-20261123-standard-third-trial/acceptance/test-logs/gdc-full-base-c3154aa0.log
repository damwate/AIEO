        ctx = make_context(site, authorities)
    
        # F1-A RELEASE admits this real V5 fixture through the production internal path.
        assert ctx.fixture_contract_integrated is True
        assert ctx.site.fixtures == [fixture]
    
        # Observe the exact shared B2 authorities while the real E1/E2-R engine
        # runs. These are instrumentation wrappers, not replacement predicates.
        from app import geometry as geometry_module
        from app.generation import assembler as assembler_module
    
        sale_checks = []
        overlap_checks = []
        e2_gate_calls = []
        restore_calls = []
        original_sale = geometry_module.fixture_sale_conflicts
        original_overlap = geometry_module.fixture_overlaps
        original_e2_gate = engine_module._e2_real_site_necessary_gate
        original_restore = assembler_module.SceneAssembler.restore
    
        def tracked_sale(scene, catalog_arg=None):
            conflicts = original_sale(scene, catalog_arg)
            sale_checks.append((len(scene.placements), len(scene.surfaces), tuple(
                (code, tuple(ids)) for code, ids in conflicts)))
            return conflicts
    
        def tracked_overlap(site_arg, geom):
            overlaps = original_overlap(site_arg, geom)
            overlap_checks.append(bool(overlaps))
            return overlaps
    
        def tracked_e2_gate(context, plan, options):
            allowed = original_e2_gate(context, plan, options)
            e2_gate_calls.append((plan.plan_key, allowed))
            return allowed
    
        def tracked_restore(assembly, checkpoint):
            restore_calls.append(checkpoint.checkpoint_id)
            return original_restore(assembly, checkpoint)
    
        monkeypatch.setattr(geometry_module, "fixture_sale_conflicts", tracked_sale)
        monkeypatch.setattr(assembler_module, "fixture_sale_conflicts", tracked_sale)
        monkeypatch.setattr(geometry_module, "fixture_overlaps", tracked_overlap)
        monkeypatch.setattr(engine_module, "_e2_real_site_necessary_gate",
                            tracked_e2_gate)
        monkeypatch.setattr(assembler_module.SceneAssembler, "restore",
                            tracked_restore)
    
        result = run_search(
            ctx, repair_mode="LOCAL_INTERNAL", deep_composition=True,
        )
    
        # Full 48/8/16 primary ledger, separate 24 cap, one primary reservation
        # per attempt. Free preflight/E2 necessity probes never reserve a ticket.
        assert result.preflight.admissible is True
        assert result.ledger.used == {
            "core": 48, "secondary": 8, "premium": 16,
        }
        assert result.ledger.total_used == 72
        assert len(result.ledger.records) == 72
        assert sorted(r.attempt_number for r in result.ledger.records) == list(range(1, 73))
        assert len({r.attempt_number for r in result.ledger.records}) == 72
        assert result.internal_repair_used == len(result.internal_repair_records)
        assert len(restore_calls) == result.internal_repair_used
        assert result.internal_repair_used <= 24
        assert result.repair_mode == "LOCAL_INTERNAL"
        assert {r.stage for r in result.ledger.records} == {
            "core", "secondary", "premium",
        }
        assert len(sale_checks) >= 72 + result.internal_repair_used  # each primary + each E1 restore hits the shared gate
        assert e2_gate_calls  # E2-R deep proposals were actually checked.
        assert overlap_checks  # E2-R and sale checks reach the same V5 overlap primitive.
    
        # A: the pool may contain legitimate paving-only candidates, but the
