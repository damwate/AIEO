    @pytest.mark.parametrize('saved', [False,True], ids=['empty-custom','saved-custom-r1'])
    @pytest.mark.parametrize('newest_status', ['done','failed','running'])
    def test_custom_latest_reads_real_history_without_reap_or_batch_changes(
            env,monkeypatch,saved,newest_status):
        from app import schemes as schemes_api
        from app.db import GenerationBatch,SiteRevision
    
        c=_client(env,'member')
        created=_create(c,env,payload=custom_wizard_payload())
        assert created.status_code==201,created.text
        p=created.json()
        pid,sid=p['project_id'],p['site_id']
        site=rect_candidate(sid)
        site['shape_type']='custom'
        site['edges']=[{**e,'type':'wall','height_mm':1800} for e in site['edges']]
        if saved:
            saved_r1=c.post(f'/api/projects/{pid}/site-revisions',
                            json={'site_json':site,'source_type':'customer_estimate'})
            assert saved_r1.status_code==200,saved_r1.text
    
        # An old done row + the requested most-recent terminal/running row;
        # a running row is deliberately far beyond the stale threshold.
        with env['factory']() as db:
            owner=env['users']['member']
            history=[]
            for idx,status in enumerate(('done',newest_status)):
                history.append(GenerationBatch(
                    workspace_id=env['ws'].workspace_id,project_id=pid,
                    created_by_user_id=owner.user_id,site_revision_id=None,
                    site_snapshot_json=site,brief_snapshot_json={},
                    candidate_count=2,result_count=2 if status=='done' else None,
                    status=status,
                    error_code='NO_LEGAL_CANDIDATES' if status=='failed' else None,
                    error_message='NO_LEGAL_CANDIDATES|历史拒因' if status=='failed' else None,
                    created_at=f'200{idx}-01-01T00:00:00+00:00'))
                db.add(history[-1])
            db.commit()
            newest_id=history[-1].batch_id
            before=[(b.batch_id,b.status,b.result_count,b.error_code,b.error_message,b.created_at)
                    for b in db.scalars(select(GenerationBatch).where(
                        GenerationBatch.project_id==pid).order_by(GenerationBatch.batch_id)).all()]
            assert len(before)==2
    
        calls=[]
        def recording_reap(_db,project_id):
            calls.append(project_id)
            return None
        monkeypatch.setattr(schemes_api,'_reap_stale_running',recording_reap)
    
        # GET is not a generation attempt; it must reveal the actual latest row
        # without ever triggering the stale-running reaper (custom read-only
        # invariant holds for both the empty shell and saved custom revisions).
        latest=c.get(f'/api/projects/{pid}/scheme-generations/latest')
        assert latest.status_code==200,latest.text
        batch=latest.json()['batch']
        assert batch is not None
        assert batch['batch_id']==newest_id
        assert batch['status']==newest_status
        if newest_status=='failed':
            assert batch['error_code']=='NO_LEGAL_CANDIDATES'
            assert batch['error_message']=='历史拒因'
        if newest_status=='running':
            assert batch['error_code'] is None
        assert calls==[]
    
        denied=c.post(f'/api/projects/{pid}/scheme-generations',headers={'Idempotency-Key':'b15-custom-deny-key'})
        if not saved:
            # B1-5 保留合同：未保存 custom 壳 POST 仍为结构化能力拒绝。
            assert denied.status_code==409,denied.text
