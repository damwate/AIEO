result = SearchResult(candidates=(PortfolioEvaluatedCandidate(scene=Scene(schema_version='1.0', site=Site(schema_version='1.0',...pair_records=(), internal_repair_used=0, repair_mode='OFF', internal_no_action_reasons=(), internal_evidence_counts=())
context = SearchContext(site_json='{"edges":[{"base_material_variant":null,"edge_id":"e0","edit_locked":false,"end_mm":[9000.0,0...tract_integrated=True, coverage_gaps=('WALL_FINISH_COLOR_SIDE_NONEXHAUSTIVE', 'FREE_PLANTER_9060_EXT_NOT_PRECOMPUTED'))

    def audit_search(result: SearchResult, context: SearchContext) -> SearchDiagnostics:
        """Pure bounded evidence projection. Does not invoke any new builder.
    
        Frozen library enumeration is a free source-count audit, NOT a claim that
        every template can be placed at a genuine site/door/corner.
        """
        if result.template_dependency_fingerprint != context.template_dependency_fingerprint:
            raise TemplateValidationError("DIAGNOSTIC_CONTEXT_TEMPLATE_MISMATCH")
        if result.complete_enumeration or result.saturation_certificate is not None:
            raise TemplateValidationError("DIAGNOSTIC_FORBIDS_SATURATION")
        if result.coverage_gaps != context.coverage_gaps:
            raise TemplateValidationError("DIAGNOSTIC_COVERAGE_GAPS_MISMATCH")
        ledger = result.ledger
        records = ledger.records
        if (len(records) != ledger.total_used
                or ledger.total_used > context.budget.total
                or sum(ledger.used.values()) != ledger.total_used):
            raise TemplateValidationError("DIAGNOSTIC_LEDGER_INCONSISTENT")
        if any((row.outcome not in ("legal", "duplicate", "rejected", "error")
                or row.stage not in STAGES) for row in records):
            raise TemplateValidationError("DIAGNOSTIC_OUTCOME_INVALID")
        statuses = Counter(row.outcome for row in records)
        legal_raw = statuses["legal"] + statuses["duplicate"]
        if statuses["legal"] != len(result.candidates):
            raise TemplateValidationError("DIAGNOSTIC_LEGAL_POOL_MISMATCH")
        if any(not item.validator.get("valid") or
               "bom" not in item.quote or "total" not in item.quote
               for item in result.candidates):
            raise TemplateValidationError("DIAGNOSTIC_UNVERIFIED_CANDIDATE")
    
        library = template_inventory(context)
        reasons: Counter[str] = Counter()
        phases: Counter[str] = Counter()
        for row in result.filters:
            code = _safe_reason(row.reason_code)
            reasons[code] += 1
            phases[_failure_phase(code)] += 1
        for row in records:
            if row.outcome == "legal":
                continue
