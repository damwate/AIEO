    def test_generate_bench_edge_no_dead_seam_and_no_overlap():
        """generate() 级回归（案1 场景）：卡座+平台+自由花坛同场时——
        ① 花坛基座不得与平台面积重叠；② 两轴任一同带时另一轴的间隙必须 0 贴合
        或 ≥150mm（花坛 900 深 vs 卡座带 750 深的固有落差），禁止 0<g<150 错缝死缝。"""
        from app.generator import generate
        base=Scene(site=make_site(width=6000,depth=4000))
        base.customer_preferences.product_intents={'bench_planter':'want','deck':'want','free_planter':'want'}
        checked=0
        for c in generate(base)['candidates']:
            bases=[p for p in c.placements if p.product_id=='free_planter_9090' and not p.parent_id]
            if not bases:continue
            decks=[s.polygon_mm for s in c.surfaces if s.type=='deck']
            if not decks:continue
            checked+=1
            for d in decks:
                dx0,dx1=min(p[0] for p in d),max(p[0] for p in d)
                dy0,dy1=min(p[1] for p in d),max(p[1] for p in d)
                for b in bases:
                    w,h,_=dimensions(catalog()['products'][b.product_id])
                    rad=math.radians(b.rotation_deg)
                    pts=[(b.x_mm+rx*math.cos(rad)-ry*math.sin(rad),b.y_mm+rx*math.sin(rad)+ry*math.cos(rad)) for rx,ry in ((0,0),(w,0),(0,h),(w,h))]
                    px0,px1=min(p[0] for p in pts),max(p[0] for p in pts)
                    py0,py1=min(p[1] for p in pts),max(p[1] for p in pts)
                    ox=max(0,min(dx1,px1)-max(dx0,px0));oy=max(0,min(dy1,py1)-max(dy0,py0))
                    assert ox*oy<1e-6, f'花坛 {b.product_id}@({b.x_mm},{b.y_mm}) 与平台面积重叠'
                    if ox>1e-6:
                        gy=max(dy0-py1,py0-dy1)
                        assert gy<=1e-6 or gy>=150-1e-6, f'花坛与平台竖向错缝 {gy:.1f}mm（死缝）'
                    if oy>1e-6:
                        gx=max(dx0-px1,px0-dx1)
                        assert gx<=1e-6 or gx>=150-1e-6, f'花坛与平台横向错缝 {gx:.1f}mm（死缝）'
