        assert len(legal_rows) == len(result.candidates)
    
        product_evidence_rows = [
            (row, candidate)
            for row, candidate in zip(legal_rows, result.candidates)
            if any(
                placement.type == "product" and placement.product_id
                for placement in candidate.scene.placements
